SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
APP_URL="http://localhost:3000"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-your-publishable-key"
# Server-only database and admin provisioning key. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_replace-with-your-service-role-key"
# Public Supabase Storage bucket for product photos.
SUPABASE_PRODUCT_IMAGES_BUCKET="product-images"

# Server-only Paystack secret. Use an sk_test_ key in non-production.
PAYSTACK_SECRET_KEY="sk_test_replace-with-your-paystack-test-secret"

# Server-only secret used by the scheduled reservation-cleanup request.
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Server-only Shipbubble delivery quote settings. Obtain these from your
# Shipbubble account and API; never expose them with a NEXT_PUBLIC_ prefix.
SHIPBUBBLE_API_KEY="sb_sandbox_replace-with-your-test-api-key"
SHIPBUBBLE_SENDER_ADDRESS_CODE="replace-with-verified-sender-address-code"
SHIPBUBBLE_FASHION_CATEGORY_ID="replace-with-fashion-wears-category-id"
# Set weights and dimensions to your actual average parcel packing measurements.
SHIPBUBBLE_ITEM_WEIGHT_KG="replace-with-measured-item-weight-kg"
SHIPBUBBLE_PACKAGE_LENGTH_CM="replace-with-measured-length-cm"
SHIPBUBBLE_PACKAGE_WIDTH_CM="replace-with-measured-width-cm"
SHIPBUBBLE_PACKAGE_HEIGHT_CM="replace-with-measured-height-cm"

# Optional server-only Cloudinary credentials, only needed to clean up legacy
# product images that were uploaded before switching to Supabase Storage.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Optional upload limits. Defaults: 8 MiB, 6000 px, 25 million pixels.
MAX_PRODUCT_IMAGE_BYTES="8388608"
MAX_PRODUCT_IMAGE_DIMENSION="6000"
MAX_PRODUCT_IMAGE_PIXELS="25000000"
