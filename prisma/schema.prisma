generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String           @default("")
  price         Int
  category      String
  colour        String?
  imageUrl      String?
  imagePublicId String?          @unique
  discountPrice Int?
  isFeatured    Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ProductVariant[]
  colours       ProductColour[]

  @@index([category])
  @@index([isActive])
}

model ProductColour {
  id        String               @id @default(cuid())
  productId String
  name      String
  hexColor  String               @default("#808080")
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductColourImage[]

  @@unique([productId, name])
  @@index([productId, sortOrder])
}

model ProductColourImage {
  id            String        @id @default(cuid())
  colourId      String
  imageUrl      String
  imagePublicId String?       @unique
  position      Int           @default(0)
  isPrimary     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  colour        ProductColour @relation(fields: [colourId], references: [id], onDelete: Cascade)

  @@index([colourId, position])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  colour    String
  size      String
  stock     Int      @default(0)
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, colour, size])
  @@index([productId])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @default(cuid())

  customerName  String
  customerEmail String
  customerPhone String

  deliveryState   String
  deliveryCity    String
  deliveryAddress String
  deliveryNotes   String @default("")

  subtotal    Int
  deliveryFee Int @default(0)
  total       Int

  orderStatus      String    @default("PENDING")
  paymentStatus    String    @default("PENDING")
  paymentReference String?   @unique
  checkoutKey      String?   @unique
  paymentExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId String
  variantId String

  productName String
  colour      String
  size        String

  unitPrice Int
  quantity  Int
  lineTotal Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}
